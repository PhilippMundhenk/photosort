PUID=1000
PGID=1000
# Home time zone (IANA). Photo EXIF times without an offset are read in it; video timestamps
# (UTC by the MP4/QuickTime spec) are converted to it. Editable later in Settings.
TZ=Europe/Berlin
# The folder that holds both inbox/ and sorted/, mounted once at /photos in the container (one
# mount: moves are renames). inbox/ has one subfolder per device (hans/, phone-b/, camera/);
# sorted/ receives the clusters. Other layouts: set the paths in Settings.
PHOTOS_BASE=/mnt/nas/photos
# Image (default: the published one; `docker compose up --build` rebuilds it locally under this name)
#PHOTOSORT_IMAGE=ghcr.io/philippmundhenk/photosort:latest
