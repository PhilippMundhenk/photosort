PUID=1000
PGID=1000
PHOTOS_INBOX_A=/mnt/nas/photos/inbox-phone-a
PHOTOS_INBOX_B=/mnt/nas/photos/inbox-phone-b
PHOTOS_ROOT=/mnt/nas/photos/sorted
# Decision model (System One API base URL). Default is the bundled Laya container.
PHOTOSORT_KEV_URL=http://laya:8000
# Where Laya's 846 MB checkpoint is cached
LAYA_MODELS=./kev-models
# Images (defaults: published ones; `docker compose up --build` rebuilds them locally under these names)
#PHOTOSORT_IMAGE=ghcr.io/philippmundhenk/photosort:latest
#LAYA_IMAGE=ghcr.io/philippmundhenk/photosort-laya:latest
